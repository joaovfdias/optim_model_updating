! DESCRIÇÃO: Script para substituição no ModBase.db (lembrar de gerar e manter na pasta)

RESUME,'ModBase','db'
/PREP7

!Atualização dos parâmetros do material
MOD_ALUM = %modulo_alum% 
POISSON = %poisson%

! MATERIAIS
MP,EX,1,MOD_ALUM
MP,PRXY,1,POISSON

ALLSEL

! SOLUÇÃO
/SOLU
ANTYPE,MODAL
MODOPT,LANB,50
MXPAND,50,,,YES ! calcula Massa Efetiva e Participação
SOLVE

FINISH













